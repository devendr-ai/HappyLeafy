{
  "expo": {
    "name": "HappyLeafy",
    "slug": "happyleafy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.happyleafy.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E7D32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.happyleafy.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "HappyLeafy",
      "shortName": "HappyLeafy",
      "themeColor": "#2E7D32",
      "backgroundColor": "#F6F8F3"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow HappyLeafy to use your camera to identify and photograph your plants.",
          "photosPermission": "Allow HappyLeafy to pick plant photos from your library."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F8F3"
        }
      ]
    ],
    "scheme": "happyleafy",
    "experiments": {
      "typedRoutes": true
    }
  }
}
